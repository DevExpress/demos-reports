        <add src="~/UserControls/Products.ascx" tagName="Products" tagPrefix="dx" />
        <add src="~/UserControls/ErrorMessage.ascx" tagName="ErrorMessage" tagPrefix="dx" />
        <add src="~/UserControls/FeedbackPanel.ascx" tagName="FeedbackPanel" tagPrefix="dx" />
        <add src="~/UserControls/ReportControlToggleButton.ascx" tagName="ReportControlToggleButton" tagPrefix="dx" />
        <add src="~/UserControls/ViewerSelector.ascx" tagName="ViewerSelector" tagPrefix="dx" />
        <add tagPrefix="dx" namespace="DevExpress.Web" assembly="DevExpress.Web.v26.1, Version=26.1.6.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
        <add tagPrefix="dx" namespace="DevExpress.XtraReports.Web" assembly="DevExpress.XtraReports.v26.1.Web.WebForms, Version=26.1.6.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
      </controls>
    </pages>
