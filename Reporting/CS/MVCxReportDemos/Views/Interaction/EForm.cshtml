@model ReportsDemoModel
@section AdditionalResources {
    <link rel="stylesheet" type="text/css" href="@this.GetUrlContentWithVersionSuffix("~/Content/RunDesignerButton.css")" />
    <link rel="stylesheet" type="text/css" href="@this.GetUrlContentWithVersionSuffix("~/Content/ViewerSelector.css")" />
    <script src="@this.GetUrlContentWithVersionSuffix("~/Scripts/Designer.js")"></script>
    <script type="text/javascript">
        function EditingFieldsHighlightingEnable(s, e) {
            e.reportPreview.editingFieldsHighlighted = true;
        }
        function OnInit(s, e) {
            RegisterNationalityEditor("@Url.Content("~/Content/")");
        }
    </script>
}

@section TopRightMenuRegion {
    @Html.Partial("ReportControlToggleButtonPartial", Model)
}

@Html.DevExpress().WebDocumentViewer(settings =>
{
    settings.Name = "webDocumentViewer";
    settings.ClientSideEvents.BeforeRender = "EditingFieldsHighlightingEnable";
    settings.ClientSideEvents.Init = "OnInit";
    settings.Height = Unit.Pixel(500);
}).Bind(Model.ReportID).GetHtml()
